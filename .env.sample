# Wi-Fi credentials baked into development builds so a board can join the
# network without going through provisioning every flash. Leave blank to
# exercise the real first-run provisioning flow instead.
WIFI_SSID=
WIFI_PASSWORD=

# Where the frame should look for its Home Assistant control plane.
# Optional: defaults to ws://homeassistant.local:8765/ws.
# Set this if mDNS does not resolve on your network, e.g.
#   HA_CONTROL_URL=ws://192.168.1.50:8765/ws
# This is an address, not a credential. The frame holds no third-party
# credentials at all - Home Assistant owns those (Constitution Principle II).
HA_CONTROL_URL=
