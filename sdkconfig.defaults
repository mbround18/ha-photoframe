CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_BSP_LCD_TYPE_1280_800=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# Match the vendor's working video_lcd_display demo. The MIPI-DSI DPI frame
# buffer sits in PSRAM and is read by DMA; the vendor ships a 64-byte L2 line
# and we were running 128.
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME is NOT set here on purpose. ESP-IDF
# resolves it against its own generated project directory, not this repo, so a
# relative path cannot work and an absolute one would be machine-specific. The
# Makefile generates an overlay with the correct absolute path at build time.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- ESP-Hosted link to the ESP32-C6 radio co-processor ---
# Verified against the board schematic; see docs/Hardware-Reference.md section 4.
# The C6 is on its own SDIO bus (GPIO14-19); the TF card is on GPIO39-44 and
# does not contend with it.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# P4 GPIO54 drives the C6 EN pin, so the host can hard-reset a wedged co-processor.
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# The ESP-IDF `driver` component always compiles the legacy I2C driver, and at
# least one managed component still references it. Everything this firmware
# actually uses (the BSP, esp_codec_dev with backward-compat off) is on the new
# i2c_master driver, so the two are never mixed at runtime -- but the legacy
# driver's constructor-time conflict check aborts the boot regardless. Skip the
# check rather than fork the components.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# --- T056 spike: BLE over ESP-Hosted ---
# The P4 has no radio: the BLE controller runs on the ESP32-C6 and only the
# NimBLE host runs here, with HCI carried over the SDIO link. Mirrors
# esp_hosted's host_nimble_bleprph_host_only_vhci example.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_FREERTOS_HZ=1000

# Two DPI frame buffers, matching the vendor's own working demo
# (CONFIG_EXAMPLE_CAM_BUF_COUNT=2). With a single buffer, esp_lcd_panel_draw_bitmap
# writes into the buffer currently being scanned out; with two it swaps, which is
# the path the vendor exercises and the one their demo is known to display with.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
