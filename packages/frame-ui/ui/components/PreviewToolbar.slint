import { PreviewChip } from "PreviewChip.slint";

export component PreviewToolbar inherits Rectangle {
    in property <string> active-screen;
    callback preview-select(string);

    width: 500px;
    height: 50px;
    background: #0f172ae6;
    border-radius: 25px;
    border-width: 1px;
    border-color: #38bdf8;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;

        PreviewChip { label: "Splash"; selected: root.active-screen == "welcome"; tapped => { root.preview-select("welcome"); } }
        PreviewChip { label: "WiFi"; selected: root.active-screen == "wifi-connect"; tapped => { root.preview-select("wifi-connect"); } }
        PreviewChip { label: "Pair"; selected: root.active-screen == "browser-pairing"; tapped => { root.preview-select("browser-pairing"); } }
        PreviewChip { label: "Auth"; selected: root.active-screen == "pairing"; tapped => { root.preview-select("pairing"); } }
        PreviewChip { label: "Ready"; selected: root.active-screen == "ready"; tapped => { root.preview-select("ready"); } }
    }
}