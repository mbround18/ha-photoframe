import { StepCard } from "StepCard.slint";

export component SetupSidebar inherits VerticalLayout {
    in property <int> active-step;
    in property <string> network-status;
    in property <string> detail-text;

    width: 380px;
    spacing: 24px;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: "DIGITAL FRAME";
            color: #38bdf8;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 2px;
        }

        Text {
            text: "Setup Progress";
            color: #ffffff;
            font-size: 38px;
            font-weight: 800;
        }
    }

    VerticalLayout {
        spacing: 12px;

        StepCard { number: "1"; title: "Power Up"; body: "Device hardware check"; active: root.active-step <= 1; complete: root.active-step > 1; }
        StepCard { number: "2"; title: "Wi-Fi"; body: "Connecting to home internet"; active: root.active-step == 2; complete: root.active-step > 2; }
        StepCard { number: "3"; title: "Pair Device"; body: "Confirm ownership from your phone"; active: root.active-step == 3; complete: root.active-step > 3; }
        StepCard { number: "4"; title: "Home Assistant"; body: "Finding and linking your controller"; active: root.active-step == 4; complete: root.active-step > 4; }
        StepCard { number: "5"; title: "Display Ready"; body: "Waiting for your first photo"; active: root.active-step == 5; complete: root.active-step == 5; }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: 20px;
        background: #0f172a88;
        border-width: 1px;
        border-color: #1e293b;

        VerticalLayout {
            padding: 20px;
            alignment: end;

            Text { text: "SYSTEM STATUS"; color: #64748b; font-size: 12px; font-weight: 800; }
            Text { text: root.network-status; color: #f8fafc; font-size: 24px; font-weight: 700; }
            Text { text: root.detail-text; color: #94a3b8; font-size: 14px; wrap: word-wrap; }
        }
    }
}