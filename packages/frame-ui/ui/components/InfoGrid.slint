import { InfoTile } from "InfoTile.slint";

export component InfoGrid inherits GridLayout {
    in property <string> active-screen;
    in property <string> network-status;
    in property <string> status-text;

    spacing: 20px;

    Row {
        InfoTile {
            label: "Action Required";
            value: (root.active-screen == "wifi-connect" ? "Join Wi-Fi" :
                    root.active-screen == "ha-syncing" ? "Open Home Assistant" : "Standby");
            hint: root.active-screen == "ha-syncing"
                ? "Settings > Devices & Services > Add Integration > PhotoFrame Bridge, then enter the ID shown above."
                : "Look at your mobile device or laptop to continue.";
            highlight: true;
        }

        InfoTile {
            label: "Controller";
            value: "Home Assistant";
            hint: "Home Assistant chooses and prepares every photo this frame shows.";
        }
    }

    Row {
        InfoTile {
            label: "Network Mode";
            value: root.network-status;
            hint: root.status-text;
        }
    }
}
