export component InfoTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <bool> highlight: false;

    border-radius: 24px;
    background: #0f172a;
    border-width: 1px;
    border-color: highlight ? #38bdf844 : #1e293b;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: label;
            color: #38bdf8;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        Text {
            text: value;
            wrap: word-wrap;
            color: #f8fafc;
            font-size: 26px;
            font-weight: 700;
            vertical-alignment: top;
        }

        Text {
            text: hint;
            wrap: word-wrap;
            color: #64748b;
            font-size: 15px;
        }
    }
}