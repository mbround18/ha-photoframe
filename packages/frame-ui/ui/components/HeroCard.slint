export component HeroCard inherits Rectangle {
    in property <string> active-screen;
    in property <string> hero-title;
    in property <string> hero-body;
    in property <string> provisioning-ssid;
    in property <string> frame-id;

    height: 320px;
    border-radius: 32px;
    background: #0f172a;
    border-width: 1px;
    border-color: #334155;

    Rectangle {
        x: -60px;
        y: -40px;
        width: 260px;
        height: 260px;
        border-radius: 130px;
        background: #1e3a5f;
        opacity: 0.18;
    }

    Rectangle {
        x: parent.width - 240px;
        y: parent.height - 200px;
        width: 220px;
        height: 220px;
        border-radius: 110px;
        background: #0f5132;
        opacity: 0.12;
    }

    VerticalLayout {
        padding: 40px;
        spacing: 16px;
        alignment: center;

        Text {
            text: root.hero-title;
            font-size: 48px;
            font-weight: 800;
            color: #ffffff;
        }

        Text {
            text: root.hero-body;
            font-size: 20px;
            color: #94a3b8;
            wrap: word-wrap;
        }

        Rectangle {
            height: 80px;
            border-radius: 16px;
            background: #02061766;
            border-width: 2px;
            border-color: #38bdf866;

            Text {
                text: (root.active-screen == "wifi-connect" ? root.provisioning-ssid :
                       root.active-screen == "ha-syncing"
                           ? (root.frame-id != "" ? root.frame-id : "Starting up...")
                           : "System Active");
                // The frame ID is long and gets typed by hand, so it needs to
                // be legible rather than dramatic; the Wi-Fi SSID can be big.
                font-size: root.active-screen == "ha-syncing" ? 34px : 42px;
                font-weight: 900;
                color: #38bdf8;
                letter-spacing: root.active-screen == "ha-syncing" ? 2px : 4px;
            }
        }
    }
}